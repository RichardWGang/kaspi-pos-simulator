      "item": [
        {
          "name": "deviceinfo - 终端信息",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/v2/deviceinfo", "host": ["{{baseUrl}}"], "path": ["v2", "deviceinfo"] }
          }
        },
        {
          "name": "register - 换取 token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const d = pm.response.json().data;",
                  "    if (d && d.accessToken) {",
                  "        pm.collectionVariables.set('accessToken', d.accessToken);",
                  "        pm.collectionVariables.set('refreshToken', d.refreshToken);",
                  "        console.log('token 已保存，expirationDate = ' + d.expirationDate);",
                  "    }",
                  "    pm.test('expirationDate 格式为 YYYY-MM-DD HH:MM:SS', () => {",
                  "        pm.expect(d.expirationDate).to.match(/^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$/);",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/v2/register?name=Kashier1", "host": ["{{baseUrl}}"], "path": ["v2", "register"], "query": [{ "key": "name", "value": "Kashier1" }] }
          }
        },
        {
          "name": "reset - 清空全部交易",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/v2/reset", "host": ["{{baseUrl}}"], "path": ["v2", "reset"] }
