                  "    console.log('status = ' + d.status + ' / subStatus = ' + d.subStatus);",
                  "    if (d.status === 'success') {",
                  "        pm.collectionVariables.set('transactionId', d.transactionId);",
                  "        console.log('transactionId = ' + d.transactionId + ' (退款要用)');",
                  "    }",
                  "    pm.test('subStatus 在手册 11 个枚举内', () => {",
                  "        const allowed = ['Initialize','WaitUser','WaitForQrConfirmation','ProcessingCard','WaitForPinCode','ProcessRefund','QrTransactionSuccess','QrTransactionFailure','CardTransactionSuccess','CardTransactionFailure','ProcessCancelled'];",
